{
  "name": "pi-schedule-prompt",
  "version": "0.4.1-fork.2",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "description": "Pi's Heartbeat - A pi extension for scheduling recurring and one-shot main agent or background prompts with cron-like functionality",
  "author": "tintinweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenhaoxiang/pi-schedule-prompt.git"
  },
  "homepage": "https://github.com/chenhaoxiang/pi-schedule-prompt#readme",
  "bugs": {
    "url": "https://github.com/chenhaoxiang/pi-schedule-prompt/issues"
  },
  "files": ["src", "dist", "docs", "prompts", "AGENTS.md", "README.md", "CHANGELOG.md", "LICENSE"],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "scheduler",
    "prompt",
    "automation",
    "cron",
    "heartbeat",
    "defer",
    "remind"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0 <2",
    "@earendil-works/pi-coding-agent": ">=1.3.0 <2",
    "@earendil-works/pi-tui": ">=1.3.0 <2"
  },
  "dependencies": {
    "croner": "10.0.1",
    "nanoid": "5.1.11"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --maxWorkers=2",
    "check": "npm run lint && npm run typecheck && npm run check:scripts && npm test && npm run build",
    "check:scripts": "node --check scripts/pack-fixed.mjs && node --check scripts/install-fixed.mjs && node --check test/online-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "pi-intercom": "https://codeload.github.com/chenhaoxiang/pi-intercom/tar.gz/073b0b2d6c015826d1fdb0f43d503f6585ceffa3",
    "@types/node": "25.9.1",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "prompts": ["./prompts"],
    "video": "https://github.com/tintinweb/pi-schedule-prompt/raw/master/media/demo.mp4",
    "image": "https://github.com/tintinweb/pi-schedule-prompt/raw/master/media/screenshot.png"
  }
}
